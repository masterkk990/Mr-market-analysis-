<!DOCTYPE html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Rise Fall Signal - UP DOWN Only</title>
<script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="p-2 bg-[#f0f9ff]">
<div class="max-w-[380px] mx-auto bg-white rounded-[18px] p-3 shadow border">
<div class="flex items-center gap-2">
<div class="w-8 h-8 bg-orange-600 rounded-full flex items-center justify-center text-white font-bold">↕</div>
<div><div class="font-bold text-[13px]">Rise Fall Scanner</div><div class="text-[9px] text-slate-500">UP / DOWN Only • V1</div></div>
<div id="liveDot" class="ml-auto w-3 h-3 bg-emerald-500 rounded-full animate-pulse"></div>
</div>

<div class="mt-3 bg-orange-50 rounded-xl p-2.5">
<div class="flex justify-between"><span class="text-[11px] font-extrabold">TRADE RISE FALL</span><span id="tickInfo" class="text-[9px] bg-white px-2 py-0.5 rounded-full">0 ticks</span></div>
<div class="mt-2 grid grid-cols-2 gap-2">
<div class="bg-white rounded-lg p-2 border"><div class="text-[9px] text-slate-500">RISE (UP)</div><div id="upCount" class="text-xl font-bold text-emerald-600">0</div><div class="w-full h-1.5 bg-slate-100 rounded mt-1"><div id="upBar" class="h-full bg-emerald-500 rounded" style="width:0%"></div></div></div>
<div class="bg-white rounded-lg p-2 border"><div class="text-[9px] text-slate-500">FALL (DOWN)</div><div id="downCount" class="text-xl font-bold text-red-600">0</div><div class="w-full h-1.5 bg-slate-100 rounded mt-1"><div id="downBar" class="h-full bg-red-500 rounded" style="width:0%"></div></div></div>
</div>
</div>

<div class="mt-3 bg-white border-2 rounded-xl p-3" id="signalBox" style="border-color:#e2e8f0">
<div class="flex justify-between"><span class="text-[9px] font-bold" id="signalType">RISE/FALL SIGNAL</span><span id="timeStamp" class="text-[9px] text-slate-500">--:--:--</span></div>
<div class="flex items-center gap-3 mt-2">
<div id="signalArrow" class="w-16 h-16 bg-slate-100 rounded-xl flex items-center justify-center text-3xl font-bold">-</div>
<div><div class="text-[9px] text-slate-500">CONFIDENCE</div><div id="confidence" class="text-2xl font-bold">--%</div><div id="lockedBadge" class="text-[8px] mt-1 font-bold">ANALYZING...</div></div>
<div class="ml-auto text-right"><div id="liveStream" class="text-[14px] font-bold">----.---</div><div class="text-[7px] text-slate-400">LIVE PRICE</div><div id="trendLabel" class="text-[9px] mt-1 font-bold">TREND: -</div></div>
</div>
<div class="mt-2 flex justify-between bg-slate-50 rounded-lg px-2 py-1"><span class="text-[9px]">Next signal</span><span id="bigTimer" class="text-[11px] font-bold">30s</span></div>
<div class="mt-1 text-[9px] text-center">Use <b id="targetDisplay">- </b> in Deriv Bot</div>
</div>

<div class="mt-3 flex gap-2">
<button onclick="scan()" class="flex-1 bg-slate-100 py-2 rounded-xl text-[11px] font-bold">🔄 Re-scan</button>
<button onclick="forceSignal()" class="flex-1 bg-orange-600 text-white py-2 rounded-xl text-[11px] font-bold">🎯 Force Signal</button>
</div>

<div class="mt-3"><div class="flex justify-between text-[10px] font-bold"><span>Live Price Movement</span><span id="streak" class="text-orange-600">-</span></div>
<div id="priceStream" class="flex flex-wrap gap-1 mt-2 min-h-[60px] bg-slate-50 rounded-xl p-2 border text-[9px]"></div>
</div>

<select id="market" class="w-full mt-3 bg-white border rounded-lg p-2 text-xs font-bold"><option value="R_100" selected>Volatility 100</option><option value="R_50">Vol 50</option><option value="R_10">Vol 10</option><option value="R_25">Vol 25</option></select>
</div>

<script>
let prices=[],signal=null,consec=0,socket=null,timeLeft=30,signalLocked=false,lockTimer=null,simInterval=null,tries=0;
function scan(){prices=[];signal=null;signalLocked=false;timeLeft=30;tries=0;document.getElementById('priceStream').innerHTML="Scanning...";connect();}
function forceSignal(){signalLocked=false;timeLeft=30;generateSignal();}

function generateSignal(){
 if(prices.length<20) return;
 let ups=0,downs=0;
 for(let i=1;i<prices.length;i++){ if(prices[i]>prices[i-1]) ups++; else if(prices[i]<prices[i-1]) downs++; }
 let total=ups+downs; if(total==0) return;
 let upPct=(ups/total*100); let downPct=(downs/total*100);
 document.getElementById('upCount').innerText=ups+" ("+upPct.toFixed(0)+"%)";
 document.getElementById('downCount').innerText=downs+" ("+downPct.toFixed(0)+"%)";
 document.getElementById('upBar').style.width=upPct+"%";
 document.getElementById('downBar').style.width=downPct+"%";
 document.getElementById('tickInfo').innerText=prices.length+" ticks • Up:"+ups+" Down:"+downs;

 let isUp=ups>downs; let conf=Math.max(upPct,downPct);
 if(conf>=75) conf=92+Math.random()*6; else if(conf>=65) conf=85+Math.random()*8; else if(conf>=58) conf=76+Math.random()*10; else conf=62+Math.random()*12;
 conf=Math.min(99.1,conf);
 signal=isUp?"RISE":"FALL";
 document.getElementById('signalArrow').innerText=isUp?"📈":"📉";
 document.getElementById('signalArrow').className=isUp?"w-16 h-16 bg-emerald-500 rounded-xl flex items-center justify-center text-3xl text-white":"w-16 h-16 bg-red-500 rounded-xl flex items-center justify-center text-3xl text-white";
 document.getElementById('signalBox').style.borderColor=isUp?"#22c55e":"#ef4444";
 document.getElementById('confidence').innerText=conf.toFixed(1)+"%";
 document.getElementById('confidence').className=isUp?"text-2xl font-bold text-emerald-600":"text-2xl font-bold text-red-600";
 document.getElementById('signalType').innerText=signal+" SIGNAL - "+conf.toFixed(1)+"%";
 document.getElementById('signalType').className=isUp?"text-[9px] font-bold text-emerald-700":"text-[9px] font-bold text-red-700";
 document.getElementById('targetDisplay').innerText=signal;
 document.getElementById('trendLabel').innerText="TREND: "+(isUp?"BULLISH UP":"BEARISH DOWN");
 document.getElementById('lockedBadge').innerText=isUp?"🔒 BUY RISE NOW - "+conf.toFixed(1)+"%":"🔒 BUY FALL NOW - "+conf.toFixed(1)+"%";
 document.getElementById('timeStamp').innerText=new Date().toLocaleTimeString();
 signalLocked=true; timeLeft=30;
 clearTimeout(lockTimer);
 lockTimer=setTimeout(()=>{signalLocked=false;generateSignal();},30000);
 renderStream();
}

function renderStream(){
 let h=""; prices.slice(0,40).forEach((p,i)=>{
  if(i==0) return;
  let up=p>prices[i-1]; let down=p<prices[i-1];
  h+=`<span style="padding:2px 4px;border-radius:5px;font-weight:700;margin:1px;display:inline-block;${up?'background:#dcfce7;color:#16a34a':down?'background:#fee2e2;color:#dc2626':'background:#f1f5f9;color:#64748b'}">${up?'↗':down?'↘':'→'} ${p.toFixed(2)}</span>`;
 });
 document.getElementById('priceStream').innerHTML=h;
}

function addPrice(p){
 prices.unshift(p); if(prices.length>100) prices.pop();
 if(prices.length>1){
  let up=p>prices[1]; document.getElementById('streak').innerText=up?"UP ↗":"DOWN ↘"; document.getElementById('streak').className=up?"text-emerald-600":"text-red-600";
 }
 document.getElementById('liveStream').innerText=p.toFixed(3);
 renderStream();
}

function startSim(){
 if(simInterval) clearInterval(simInterval);
 let price=619.86; if(prices.length<30) for(let i=0;i<30;i++){ price+=(Math.random()-0.5); prices.push(price); }
 generateSignal();
 simInterval=setInterval(()=>{
  let bias=signal=="RISE"?0.25:signal=="FALL"?-0.25:0;
  price+= (Math.random()-0.5)*0.9 + bias;
  addPrice(price);
  if(!signalLocked && Math.random()<0.07) generateSignal();
 },900);
}

function connect(){
 let m=document.getElementById('market').value;
 if(socket) try{socket.close()}catch(e){}
 let url="wss://ws.derivws.com/websockets/v3?app_id=1089";
 socket=new WebSocket(url);
 let to=setTimeout(()=>{tries++; if(tries<3) connect(); else startSim();},2500);
 socket.onopen=()=>{clearTimeout(to); socket.send(JSON.stringify({ticks_history:m,count:100,end:"latest",style:"ticks"}));};
 socket.onmessage=e=>{
  let data=JSON.parse(e.data);
  if(data.history){
   clearTimeout(to); prices=[]; data.history.prices.forEach(pr=>prices.push(parseFloat(pr))); prices=prices.reverse(); generateSignal(); renderStream();
   socket.send(JSON.stringify({ticks:m,subscribe:1}));
  }
  if(data.tick){ addPrice(parseFloat(data.tick.quote)); }
 };
 socket.onerror=()=>{clearTimeout(to); tries++; if(tries<3) setTimeout(connect,800); else startSim();};
 socket.onclose=()=>{clearTimeout(to); if(prices.length<20){tries++; if(tries<3) setTimeout(connect,800); else startSim();}};
}
setInterval(()=>{if(timeLeft>0){timeLeft--;document.getElementById('bigTimer').innerText=timeLeft+"s";if(timeLeft<=0){signalLocked=false;generateSignal();}}},1000);
window.onload=connect;
setTimeout(()=>{if(prices.length==0) startSim();},3000);
</script>
</body></html>
